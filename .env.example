# Скопируйте в .env и заполните своими значениями.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Telegram API (https://my.telegram.org → API development tools).
# Сессия создаётся при первом запуске сервиса: media_session.session (в git не попадает).
TG_API_ID_2=
TG_API_HASH_2=

# LLM для разбора объявлений (любой API, совместимый с OpenAI; по умолчанию OpenRouter)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.7-flash

# Вход по паролю на сайт (True — включён, False — сайт открыт)
SITE_LOGIN_REQUIRED=True

# Отдавать фото через Django без DEBUG (для временного показа; на сервере — nginx)
SERVE_MEDIA=False

# Адрес сайта для поисковиков (canonical, карта сайта, превью ссылок)
SITE_URL=https://goadoska.ru
